    },
    "se-arquitecto-ia-datos": {
      "claude_tools": "Read, Grep, Glob, Write, Edit, Bash",
      "codex_sandbox": "workspace-write"
    },
    "se-arquitecto-solucion": {
      "claude_tools": "Read, Grep, Glob, Write, Edit, Bash",
      "codex_sandbox": "workspace-write"
    },
    "se-disenador-aplicacion": {
      "claude_tools": "Read, Grep, Glob, Write, Edit, Bash",
      "codex_sandbox": "workspace-write"
    },
    "se-redactor-specs": {
      "claude_tools": "Read, Grep, Glob, Write, Edit, Bash",
      "codex_sandbox": "workspace-write"
    },
    "se-planificador-backlog": {
      "claude_tools": "Read, Grep, Glob, Write, Edit, Bash",
      "codex_sandbox": "workspace-write"
    },
    "se-revisor-coherencia": {
      "claude_tools": "Read, Grep, Glob, Write, Bash",
      "codex_sandbox": "workspace-write"
    }
  },
  "requirements": {
    "id_pattern": "^RQ-\\d{3}$",
    "inline_id_regex": "\\b(?:RQ-HU-\\d{3}|RQ-\\d{3})\\b",
    "types": {
      "funcional": [
        "Funcional"
      ],
      "tecnico": [
        "No funcional",
        "Datos",
        "IA/Analítica",
        "Integración",
        "Seguridad",
        "Privacidad",
        "Infraestructura",
        "Operación",
        "Calidad/Testing",
        "Restricción tecnológica"
      ],
      "otros": [
        "Contractual/Entregable",
        "Gestión"
      ]
    },
    "coverage_required": [
      "funcional",
      "tecnico"
    ],
    "states": [
      "Evidenciado",
      "Inferido",
      "A confirmar",
      "Fuera de alcance"
    ],
    "priorities": [
      "Obligatorio",
      "Deseable",
      "Opcional",
      "A confirmar"
    ],
    "chunk_lines": 80,
    "dedupe": {
      "backend": "lexico",
      "lexico": {
        "alta": 0.8,
        "revisar": 0.5
      },
      "azure": {
        "endpoint_env": "AZURE_OPENAI_ENDPOINT",
        "api_key_env": "AZURE_OPENAI_API_KEY",
        "api_version": "2024-10-21",
        "deployment": "text-embedding-3-small",
        "batch": 256,
        "alta": 0.85,
        "revisar": 0.72
      },
      "max_rq_por_capacidad": 8,
      "max_capacidades_por_hu": 2
    }
  },
  "python": {
    "runner": "uv run --group se",
    "group": "se",
    "deps": [
      "drawpyo",
      "openpyxl",
      "pandas",
      "pdfplumber",
      "pyarrow",
      "pypdf",
      "python-docx",
      "python-pptx"
    ],
    "embeddings_deps": [
      "openai",
      "azure-identity"
    ]
  },
