    "sources_dir": "RFP",
    "samples_dir": "data-samples",
    "templates_dir": "templates",
    "output_dir": "proposal"
  },
  "evidence_states": [
    "Evidenciado",
    "Inferido",
    "Propuesto",
    "Preferente",
    "Alternativa condicionada",
    "Dependencia crítica",
    "Nueva capacidad requerida",
    "Gobernado por plataforma",
    "A confirmar",
    "Ejemplo orientativo",
    "No aplica"
  ],
  "backlog": {
    "roles": [
      "Architect",
      "Backend",
      "Frontend",
      "DS",
      "DataEng",
      "DevOps",
      "UI/UX",
      "QA"
    ],
    "devops_only_roles": [
      "DevOps"
    ],
    "forbidden_story_roles": [
      "arquitecto",
      "architect",
      "backend",
      "frontend",
      "data scientist",
      "cientifico de datos",
      "ingeniero de datos",
      "data engineer",
      "devops",
