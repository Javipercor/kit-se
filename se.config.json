      "project manager",
      "jefe de proyecto",
      "desarrollador",
      "developer",
      "programador",
      "equipo tecnico",
      "sistema"
    ],
    "min_criteria": 3,
    "max_criteria": 7,
    "min_hours": 1,
    "max_hours": 16,
    "levels": {
      "N1": "Tarea conocida, sin incertidumbre, patrón repetible",
      "N2": "Complejidad moderada, dependencias conocidas",
      "N3": "Complejidad alta o integración con terceros con contrato parcial",
      "N4": "Alta incertidumbre: datos, contrato o tecnología sin validar"
    },
    "fixed_epics": {
      "first": "Arquitectura",
      "penultimate": "DevOps",
      "last": "Documentacion y Entregables"
    },
    "default_phase": "Fase única - Implementación del caso de uso"
  },
  "agents": {
    "se-lider-proyecto": {
      "claude_tools": "Read, Grep, Glob, Write, Edit, Bash, Task",
      "codex_sandbox": "workspace-write"
    },
    "se-analista-corpus": {
      "claude_tools": "Read, Grep, Glob, Write, Edit, Bash",
      "codex_sandbox": "workspace-write"
    },
